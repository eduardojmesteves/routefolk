{
  "name": "routefolk",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:static",
    "test:unit": "vitest run tests/unit",
    "test:static": "vitest run tests/static",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "jsdom": "^24.1.0",
    "playwright": "^1.44.0",
    "prettier": "^3.3.0",
    "vitest": "^1.6.0"
  }
}
