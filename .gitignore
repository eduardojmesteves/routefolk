# ============================================================
# routefolk — .gitignore
# ============================================================

# Local administration tooling — never deploy
/tools/

# Test infrastructure — run locally, never commit
/tests/
/node_modules/
/package.json
/package-lock.json
vitest.config.js
playwright.config.js
.eslintrc.cjs
.prettierrc
/coverage/
/playwright-report/
/test-results/
/.nyc_output/

# Environment and secrets
.env
.env.*
!.env.example
*.local
.dev.vars*
!.dev.vars.example

# Build/output folders
/dist/
/build/
/out/

# Hosting/platform folders
.vercel/
.netlify/
.wrangler/
/.cloudflare/

# OS files
.DS_Store
.AppleDouble
Thumbs.db
desktop.ini

# Editor/IDE state
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*

# Supabase local development artifacts
.supabase/
supabase/.branches/
supabase/.temp/

# Temporary files
*.tmp
*.temp
.cache/
.tmp/
tmp/
temp/

# The containerised Agent API is production source, not local test tooling.
!/agent-api/package.json
!/agent-api/package-lock.json
