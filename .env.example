POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
# Generate these two JWTs from JWT_SECRET with infrastructure/docker/setup-env.sh:
ANON_KEY=replace-with-anon-jwt
SERVICE_ROLE_KEY=replace-with-service-role-jwt
AGENT_API_KEY=replace-with-a-long-random-token
AGENT_USER_ID=00000000-0000-4000-8000-000000000001
# Public HTTPS origin of the home-server backend, with no trailing slash.
API_EXTERNAL_URL=https://routefolk-api.example.com
# Existing Cloudflare Pages PWA origin, with no trailing slash.
SITE_URL=https://routefolk.pages.dev
BIND_ADDRESS=127.0.0.1
PORT=18080
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAILER_AUTOCONFIRM=true
DISABLE_SIGNUP=false
